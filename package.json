{
  "name": "web-operating-system",
  "version": "3.7.0",
  "description": "A production-grade web-based operating system with enterprise security, real-time collaboration, AI capabilities, multi-user support, developer tools, and advanced productivity features that runs entirely in your browser",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:wasm && vite build",
    "build:wasm": "npm run build:wasm:compression && npm run build:wasm:crypto && npm run build:wasm:text",
    "build:wasm:compression": "wasm-pack build wasm-modules/compression --target web --out-dir ../../public/wasm/compression",
    "build:wasm:crypto": "wasm-pack build wasm-modules/crypto --target web --out-dir ../../public/wasm/crypto",
    "build:wasm:text": "wasm-pack build wasm-modules/text-processing --target web --out-dir ../../public/wasm/text-processing",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "repository": {
    "type": "git",
    "url": "http://local_proxy@127.0.0.1:37179/git/Sir-Teo/web-operating-system"
  },
  "keywords": [
    "webos",
    "operating-system",
    "browser",
    "pwa",
    "file-system",
    "ai",
    "machine-learning",
    "llm",
    "devtools",
    "debugging",
    "profiling"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.8",
    "@vitest/ui": "^2.1.8",
    "eslint": "^9.39.1",
    "gh-pages": "^6.3.0",
    "happy-dom": "^15.11.7",
    "prettier": "^3.6.2",
    "terser": "^5.44.1",
    "vite": "^7.2.2",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "monaco-editor": "^0.50.0",
    "pako": "^2.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "simple-peer": "^9.11.1",
    "vite-plugin-monaco-editor": "^1.1.0",
    "winbox": "^0.2.82",
    "y-webrtc": "^10.3.0",
    "yjs": "^13.6.20"
  }
}
